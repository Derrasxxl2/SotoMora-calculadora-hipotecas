<footer>
  Cálculo orientativo basado en el criterio habitual de los bancos españoles (máx. 80% de financiación y cuota ≤ 35% del salario neto). No constituye asesoramiento financiero.
</footer>

<script>
function fmt(n) {
  return Math.round(n).toLocaleString('es-ES') + ' €';
}

function calcular() {
  var salario = parseFloat(document.getElementById('salario').value) || 0;
  var ahorros = parseFloat(document.getElementById('ahorros').value) || 0;
  var plazo = parseInt(document.getElementById('plazo').value);
  var tin = parseFloat(document.getElementById('interes').value) / 100;

  var maxCuota = salario * 0.35;
  var n = plazo * 12;
  var r = tin / 12;

  var hipotecaMaxPorCuota;
  if (r === 0) {
    hipotecaMaxPorCuota = maxCuota * n;
  } else {
    hipotecaMaxPorCuota = maxCuota * (1 - Math.pow(1 + r, -n)) / r;
  }

  var hipotecaMaxPorBanco = salario * 12 * 8;
  var hipoteca = Math.min(hipotecaMaxPorCuota, hipotecaMaxPorBanco);

  var ahorrosUtiles = ahorros * 0.8;
  var precioMax = hipoteca + ahorrosUtiles;

  var cuota;
  if (r === 0) {
    cuota = hipoteca / n;
  } else {
    cuota = hipoteca * r * Math.pow(1 + r, n) / (Math.pow(1 + r, n) - 1);
  }

  document.getElementById('precio-max').textContent = fmt(precioMax);
  document.getElementById('hipoteca').textContent = fmt(hipoteca);
  document.getElementById('cuota').textContent = Math.round(cuota).toLocaleString('es-ES') + ' €/mes';

  var pct = salario > 0 ? (cuota / salario * 100) : 0;
  document.getElementById('pct-label').textContent = Math.round(pct) + '%';

  var barra = document.getElementById('barra');
  barra.style.width = Math.min(pct, 100) + '%';

  var semaforo = document.getElementById('semaforo');
  if (pct <= 30) {
    barra.style.background = '#74B820';
    semaforo.className = 'semaforo ok';
    semaforo.textContent = '✓ Esfuerzo cómodo. Tu hipoteca encaja bien con tu salario.';
  } else if (pct <= 40) {
    barra.style.background = '#D4820A';
    semaforo.className = 'semaforo warning';
    semaforo.textContent = '⚠ Esfuerzo moderado. Asegúrate de tener un colchón de emergencia.';
  } else {
    barra.style.background = '#C23030';
    semaforo.className = 'semaforo danger';
    semaforo.textContent = '✗ Esfuerzo alto. Los bancos suelen rechazar hipotecas por encima del 40% del salario.';
  }

  var gastosCompra = precioMax * 0.10;
  var ahorrosNecesarios = precioMax * 0.20 + gastosCompra;

  document.getElementById('desglose').innerHTML =
    '<div class="desglose-row"><span>Entrada mínima (20%)</span><strong>' + fmt(precioMax * 0.20) + '</strong></div>' +
    '<div class="desglose-row"><span>Gastos de compra (~10%)</span><strong>' + fmt(gastosCompra) + '</strong></div>' +
    '<div class="desglose-row"><span>Ahorros necesarios estimados</span><strong>' + fmt(ahorrosNecesarios) + '</strong></div>' +
    '<div class="desglose-row"><span>Cuota máxima recomendada</span><strong>' + fmt(maxCuota) + '/mes</strong></div>';
}

calcular();
</script>
</body>
